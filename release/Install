; Prince of Persia 2 Installer 43 script, adapted from Vette!/Alone in the Dark.
; $VER: Install 0.90 (19.10.2026)
(set @app-name "Prince of Persia 2")
(set #source (pathonly @icon))
(set @execute-dir #source)
(if (< @installer-version (* 43 65536))
  (abort "This installation requires Amiga Installer 43 or newer."))
(welcome)
(if (<> (run "cd SYS:\nWhich WHDLoad >NIL:") 0)
  (abort "Please install WHDLoad first (https://www.whdload.de)."))
(set #parent
  (askdir
    (prompt "Where should Prince of Persia 2 be installed?")
    (help "Select a hard disk drawer. Allow 40 MB free for a fresh install and additional space for an existing-installation backup. Do not install to RAM:.")
    (default @default-dest)))
(set #dest (tackon #parent "Prince of Persia 2"))
(set #helper (tackon #source "Pop2InstallData"))
(set #reuse 0)
(if (exists #dest)
  ((working "Checking the existing installation...")
   (set #valid (run ("\"%s\" --verify \"%s\"" #helper #dest)))
   (if (= #valid 0)
     (set #reuse
       (askbool
         (prompt "Use the verified installed data or reinstall from the original archive?")
         (help "Use existing skips archive selection. Both choices preserve saved games and preferences. The previous installation is kept in .replaced.")
         (choices "Use existing" "Reinstall")
         (default 1))))))
(if (= #reuse 0)
  ((set #archive
     (askfile
       (prompt "Select Prince_Of_Persia2.SIT.")
       (help "Supply your original Macintosh Prince of Persia 2 StuffIt archive. Leave it compressed; the installer verifies its SHA-256 before extracting.")
       (default "Prince_Of_Persia2.SIT")))
   (set #attempt 0)
   (set #stage (tackon #parent (".pop2-stage-%ld" #attempt)))
   (while (exists #stage)
     ((set #attempt (+ #attempt 1))
      (set #stage (tackon #parent (".pop2-stage-%ld" #attempt)))))
   (if (= @pretend 0)
     ((working "Extracting and verifying the game data. This may take several minutes.")
      (set #result (run ("\"%s\" \"%s\" \"%s\"" #helper #archive #stage)))
      (if (<> #result 0)
        (abort "Extraction failed. The existing installation has not been changed. See the helper's error message."))))))
; Preserve the complete previous installation before changing any installed file.
(set #backup "")
(if (exists #dest)
  ((set #backups (tackon #parent ".replaced"))
   (makedir #backups (help @makedir-help))
   (set #attempt 0)
   (set #backup (tackon #backups ("PrinceOfPersia2-%ld" #attempt)))
   (while (exists #backup)
     ((set #attempt (+ #attempt 1))
      (set #backup (tackon #backups ("PrinceOfPersia2-%ld" #attempt)))))
   (if (= @pretend 0)
     (if (<> (run ("Rename \"%s\" AS \"%s\"" #dest #backup)) 0)
       (abort "Could not preserve the existing installation; no update was applied.")))
   (makedir #dest (infos) (help @makedir-help))
   (copyfiles (source #backup) (dest #dest) (all) (help @copyfiles-help))))
(makedir #dest (infos) (help @makedir-help))
(if (= #reuse 0)
  ((copyfiles (source #stage) (dest #dest) (all) (help @copyfiles-help))
   ; Only our verified temporary tree is removed. The old installation is retained.
   (delete #stage (all) (optional "force"))
   (if (<> #backup "")
    (if (= (run ("\"%s\" --verify-options \"%s\"" #helper #backup)) 0)
     ((if (exists (tackon #backup "Data/Prince2.opt"))
        (copyfiles (source (tackon #backup "Data/Prince2.opt")) (dest (tackon #dest "Data")) (help @copyfiles-help)))
      (if (exists (tackon #backup "Data/Prince2.opt.finfo"))
        (copyfiles (source (tackon #backup "Data/Prince2.opt.finfo")) (dest (tackon #dest "Data")) (help @copyfiles-help))))))))
(complete 90)
(copyfiles (source (tackon #source "PrinceOfPersia2")) (dest #dest) (help @copyfiles-help))
(copyfiles (source (tackon #source "PrinceOfPersia2.slave")) (dest #dest) (help @copyfiles-help))
(copyfiles (source (tackon #source "video-transfer.bin")) (dest #dest) (help @copyfiles-help))
(copyfiles (source (tackon #source "ReadMe")) (dest #dest) (infos) (help @copyfiles-help))
(copyfiles (source (tackon #source "PrinceOfPersia2.inf")) (dest #dest) (newname "PrinceOfPersia2.info") (help @copyfiles-help))
(tooltype (dest (tackon #dest "PrinceOfPersia2")) (settooltype "Slave") (settooltype "PreLoad"))
(tooltype (dest (tackon #dest "PrinceOfPersia2"))
  (setdefaulttool "WHDLoad") (settooltype "Slave" "PrinceOfPersia2.slave")
  (settooltype "PreLoad" "") (setstack 10240) (noposition))
(set @default-dest #dest)
(complete 100)
(exit)
